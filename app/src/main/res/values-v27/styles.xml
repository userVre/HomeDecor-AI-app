<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HomeDecor" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#386A20</item>
    </style>

    <style name="Theme.HomeDecor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFCF7</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.HomeDecor</item>
    </style>
</resources>
